    "outputs": [
      {"name": "gameType_",  "type": "uint32"},
      {"name": "timestamp_", "type": "uint64"},
      {"name": "proxy_",     "type": "address"}
    ],
    "stateMutability": "view"
  },
  {
    "type": "function",
    "name": "gameCount",
    "inputs": [],
    "outputs": [{"name": "gameCount_", "type": "uint256"}],
    "stateMutability": "view"
  },
  {
    "type": "function",
    "name": "findLatestGames",
