# Application
APP_NAME=erigon-l1-bridge
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=debug

# L1 node (Ethereum mainnet or local devnet via Erigon)
L1_RPC_URL=http://localhost:8545
L1_WS_URL=ws://localhost:8546
L1_BRIDGE_ADDRESS=
L1_PORTAL_ADDRESS=

# Base (OP Stack, chain ID 8453)
# Testnet (free faucet): https://docs.base.org/docs/tools/network-faucets/
BASE_RPC_URL=https://mainnet.base.org
BASE_WS_URL=
BASE_BRIDGE_ADDRESS=0x4200000000000000000000000000000000000010
BASE_PORTAL_ADDRESS=0x49048044D57e1C92A77f2efC7ec62b33d176bf8
BASE_POLL_INTERVAL_SEC=2

# Paymaster (EIP-7702 — post Pectra)
# NEVER commit a real private key. Use KMS or HSM in production.
PAYMASTER_PRIVATE_KEY=
PAYMASTER_ADDRESS=
CLEARING_CONTRACT_ADDRESS=

# Bridge signer (submits proveWithdrawal + finalizeWithdrawal to L1)
# NEVER commit a real private key.
BRIDGE_SIGNER_PRIVATE_KEY=

# Optional address overrides (leave blank to use Base mainnet defaults)
PORTAL_ADDRESS_OVERRIDE=
FACTORY_ADDRESS_OVERRIDE=
